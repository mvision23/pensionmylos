---
/**
 * Contact form → Netlify function /api/contact → Formspree.
 *
 * Bot check: Google reCAPTCHA (Cloud Fraud Defense).
 *  - Invisible v3: on submit the page gets a v3 token for the action "contact"
 *    and posts it with the form. The function scores it with Google.
 *  - Challenge on low score: only if the function answers `challenge`, the
 *    page loads reCAPTCHA Enterprise (enterprise.js) and shows its "I'm not a
 *    robot" checkbox (with an image test when Google is unsure); ticking it
 *    resends the form automatically. Needs site.recaptchaChallengeSiteKey;
 *    without it low scores are just rejected.
 *  - Lazy: the reCAPTCHA script is not part of the page load. It is fetched
 *    when the form comes near the viewport or the visitor interacts with it,
 *    and the Send button stays disabled until it is ready.
 *
 * After a successful send the visitor lands on our own thank-you page
 * (/<lang>/thanks/), the conversion URL for Analytics, and a `generate_lead`
 * event is sent too.
 *
 * reCAPTCHA needs JavaScript, so without it the form cannot be sent; the phone
 * number and email address shown next to it remain available.
 */
import { site } from '../data/site';
import type { Locale } from '../i18n/config';
import { fmt, getMessages, localePath } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = getMessages(locale);
const t = m.contact;
---

<div class="grid gap-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-20">
  <div>
    <h2 class="mylos-heading" set:html={t.heading} />
    <p class="mt-8 max-w-prose text-ink-soft">{t.text}</p>
    <dl class="mt-10 space-y-6">
      <div>
        <dt class="text-sm text-ink-soft">{t.phone}</dt>
        <dd class="mt-1 text-xl"><a class="hover:text-mylos-700" href={site.phoneHref}>{site.phone}</a></dd>
      </div>
      <div>
        <dt class="text-sm text-ink-soft">{t.email}</dt>
        <dd class="mt-1 text-xl"><a class="hover:text-mylos-700" href={`mailto:${site.email}`}>{site.email}</a></dd>
      </div>
      <div>
        <dt class="text-sm text-ink-soft">{t.address}</dt>
        <dd class="mt-1 text-xl">
          <a class="hover:text-mylos-700" href={site.mapsUrl} target="_blank" rel="noopener">{m.meta.address}</a>
        </dd>
      </div>
    </dl>
  </div>

  <form
    action={site.contactEndpoint}
    method="post"
    class="grid gap-5 self-start border border-stone bg-white p-6 sm:p-10"
    data-contact-form
    data-thanks={localePath(locale, '/thanks/')}
    data-lang={locale}
    data-sending={t.sending}
    data-error={fmt(t.error, { email: site.email })}
    data-unavailable={fmt(t.unavailable, { email: site.email })}
    data-challenge-text={t.challenge}
    data-recaptcha={site.recaptchaSiteKey}
    data-recaptcha-challenge={site.recaptchaChallengeSiteKey}
    data-recaptcha-hl={locale === 'zh' ? 'zh-CN' : locale}
  >
    <p class="text-2xl font-normal">{t.formTitle}</p>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label class="field-label" for="c-name">{t.name}</label>
        <input class="field" id="c-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div>
        <label class="field-label" for="c-email">{t.emailField}</label>
        <input class="field" id="c-email" name="email" type="email" autocomplete="email" required />
      </div>
    </div>
    <div>
      <label class="field-label" for="c-message">{t.message}</label>
      <textarea class="field min-h-36" id="c-message" name="message" rows="5" required></textarea>
    </div>

    <!-- Context for the email the pension receives -->
    <input type="hidden" name="language" value={locale} />
    <input type="hidden" name="_subject" value={`Pension Mylos website — new message (${locale.toUpperCase()})`} />
    <!-- Bot trap, checked by the Netlify function -->
    <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <p data-form-status role="alert" class="hidden border-l-2 border-mylos-600 bg-mylos-50 px-4 py-3 text-ink"></p>

    <!-- reCAPTCHA v2 checkbox, rendered here only when the v3 score is too low -->
    <div data-challenge class="hidden"></div>

    <!-- Disabled until reCAPTCHA has loaded (enabled by the script below) -->
    <button type="submit" disabled class="btn-primary justify-self-start disabled:cursor-wait disabled:opacity-70">{t.send}</button>

    <p class="text-xs text-ink-soft">
      {t.recaptchaNote}{' '}
      <a class="underline underline-offset-2 hover:text-mylos-700" href={localePath(locale, '/privacy/')}>{m.legal.link}</a>
    </p>
  </form>
</div>

<script>
  import { loadChallenge, loadV3, type Grecaptcha } from '../lib/recaptcha-client';

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const challengeBox = form.querySelector<HTMLElement>('[data-challenge]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = button.textContent ?? '';
    const {
      thanks = '/thanks/',
      lang = 'en',
      sending = '…',
      error = '',
      unavailable = error,
      challengeText = '',
      recaptcha = '',
      recaptchaChallenge = '',
      recaptchaHl = lang,
    } = form.dataset;

    // Keep our own references: enterprise.js may replace window.grecaptcha.
    let grecaptcha: Grecaptcha | null = null;
    let enterprise: Grecaptcha | null = null;
    let challengeId: number | null = null;

    const setBusy = (busy: boolean) => {
      button.disabled = busy;
      button.textContent = busy ? sending : label;
    };
    const showStatus = (text: string) => {
      status.textContent = text;
      status.classList.remove('hidden');
    };
    const fail = (text: string) => {
      showStatus(text);
      setBusy(false);
    };

    // --- Lazy loading ------------------------------------------------------
    // Fetch reCAPTCHA only when the form is about to be seen or used, so it
    // doesn't compete with the page itself.
    const start = () => {
      observer?.disconnect();
      form.removeEventListener('focusin', start);
      form.removeEventListener('pointerenter', start);
      loadV3(recaptcha, recaptchaHl).then(
        (g) => {
          grecaptcha = g;
          status.classList.add('hidden');
          button.disabled = false;
        },
        () => {
          showStatus(unavailable);
          // Try again if the visitor comes back to the form.
          form.addEventListener('focusin', start, { once: true });
        },
      );
    };
    const observer =
      'IntersectionObserver' in window
        ? new IntersectionObserver((entries) => entries.some((e) => e.isIntersecting) && start(), { rootMargin: '400px 0px' })
        : null;
    if (observer) observer.observe(form);
    else start();
    form.addEventListener('focusin', start, { once: true });
    form.addEventListener('pointerenter', start, { once: true });

    // --- Low-score challenge ----------------------------------------------
    // The Enterprise checkbox script is fetched only now, after the function
    // reported a low v3 score.
    const showChallenge = async () => {
      try {
        enterprise ??= await loadChallenge(recaptchaHl);
      } catch {
        fail(unavailable);
        return;
      }
      if (challengeId === null) {
        challengeBox.classList.remove('hidden');
        challengeId = enterprise.render(challengeBox, {
          sitekey: recaptchaChallenge,
          action: 'contact',
          // Ticking the box (and passing any image test) sends the form.
          callback: () => form.requestSubmit(),
        });
      } else {
        enterprise.reset(challengeId);
      }
      fail(challengeText);
    };

    // Tell Analytics about the lead, then go to the thank-you page. The redirect
    // happens on the hit callback or after 1 s at most, whichever comes first.
    const succeed = () => {
      let done = false;
      const go = () => { if (!done) { done = true; window.location.assign(thanks); } };
      const w = window as any;
      try {
        if (typeof w.gtag === 'function') {
          w.gtag('event', 'generate_lead', { form_id: 'contact', language: lang, event_callback: go, event_timeout: 1000 });
        } else if (typeof w.ga === 'function') {
          w.ga('send', 'event', 'Contact form', 'submit', lang, { hitCallback: go });
        }
      } catch { /* analytics must never block the redirect */ }
      setTimeout(go, 1000);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const g = grecaptcha;
      if (!g || button.disabled) return;
      status.classList.add('hidden');

      const body = new FormData(form);
      if (enterprise && challengeId !== null) {
        const answer = enterprise.getResponse(challengeId);
        if (!answer) { showStatus(challengeText); return; }
        body.set('recaptchaChallengeToken', answer);
      }

      setBusy(true);
      try {
        if (challengeId === null) {
          // v3 tokens expire after 2 minutes, so get a fresh one per send.
          body.set('recaptchaToken', await g.execute(recaptcha, { action: 'contact' }));
        }
        const res = await fetch(form.action, {
          method: 'POST',
          body,
          headers: { Accept: 'application/json' },
        });
        const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (res.ok && data.ok) {
          succeed();
        } else if (data.error === 'challenge' && recaptchaChallenge) {
          await showChallenge();
        } else {
          // Failed bot check, a rejected field, or the service is down: the
          // message includes our email address as an alternative.
          fail(error);
        }
      } catch {
        fail(error);
      }
    });
  });
</script>
