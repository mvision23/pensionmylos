---
import Logo from './Logo.astro';
import { site, nav } from '../data/site';
import type { Locale } from '../i18n/config';
import { fmt, getMessages, localePath } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getMessages(locale);
const year = new Date().getFullYear();
---

<footer class="relative z-[70] bg-sea-900 text-white/80">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 sm:px-8 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Logo class="h-14 w-auto text-white" />
      <p class="mt-5 max-w-sm">
        {t.footer.tagline}
      </p>
      <a href={site.kayak} target="_blank" rel="noopener" class="mt-6 inline-block opacity-90 hover:opacity-100">
        <img
          src="https://content.r9cdn.net/seo-res/badges/v5/LIGHT_SMALL_TRAVEL_AWARDS.png"
          alt="KAYAK Travel Awards"
          width="264"
          height="40"
          class="h-6 w-auto"
          loading="lazy"
        />
      </a>
    </div>

    <div>
      <h2 class="text-lg font-medium text-white [&_em]:text-mylos-400 [&_em]:not-italic" set:html={t.footer.contactHeading} />
      <ul class="mt-5 space-y-3">
        <li><a class="hover:text-mylos-400" href={site.phoneHref}>{site.phone}</a></li>
        <li><a class="hover:text-mylos-400" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a class="hover:text-mylos-400" href={site.mapsUrl} target="_blank" rel="noopener">{t.meta.address}</a></li>
      </ul>
    </div>

    <div>
      <h2 class="text-lg font-medium text-white">{t.footer.explore}</h2>
      <ul class="mt-5 space-y-3">
        {nav.map((item) => <li><a class="hover:text-mylos-400" href={localePath(locale, item.path)}>{t.nav[item.key]}</a></li>)}
        <li><a class="hover:text-mylos-400" href={localePath(locale, '/reservations/')}>{t.nav.reservations}</a></li>
      </ul>
      <ul class="mt-8 flex gap-3" aria-label={t.footer.social}>
        <li>
          <a href={site.social.facebook} target="_blank" rel="noopener" class="grid size-11 place-items-center border border-white/25 hover:border-mylos-400 hover:text-mylos-400">
            <span class="sr-only">Facebook</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="currentColor"><path d="M14 8.5V6.8c0-.8.2-1.3 1.4-1.3H17V2.6A21 21 0 0 0 14.6 2.5c-2.4 0-4 1.4-4 4.1v1.9H8v3.2h2.6V21H14v-9.3h2.6l.4-3.2H14z"/></svg>
          </a>
        </li>
        <li>
          <a href={site.social.instagram} target="_blank" rel="noopener" class="grid size-11 place-items-center border border-white/25 hover:border-mylos-400 hover:text-mylos-400">
            <span class="sr-only">Instagram</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-5 py-6 text-sm text-white/60 sm:px-8">
      <p>{fmt(t.footer.rights, { year })}</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <a href={localePath(locale, '/privacy/')} class="underline underline-offset-4 hover:text-mylos-400">{t.legal.link}</a>
        <button type="button" data-cookie-settings class="underline underline-offset-4 hover:text-mylos-400">{t.footer.cookieSettings}</button>
      </div>
    </div>
  </div>
</footer>
