---
import { localeInfo, type Locale } from '../i18n/config';

interface Props {
  date: Date;
  lang?: Locale;
}
const { date, lang = 'en' } = Astro.props;
---

<time datetime={date.toISOString()}>
  {date.toLocaleDateString(localeInfo[lang].dateLocale, { day: 'numeric', month: 'long', year: 'numeric' })}
</time>
